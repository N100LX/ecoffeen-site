# Every local asset is referenced with ?v=<content hash> (tools/build.py), so a changed file
# always has a new URL -> safe to cache for a year. HTML is short-cached (revalidate every load) so phones
# pick up a deploy immediately; unchanged pages still come back as cheap 304s via ETag.
/img/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/site.min.js
  Cache-Control: public, max-age=31536000, immutable
# fetched by crawlers / OS without a ?v
/img/og-share.jpg
  ! Cache-Control
  Cache-Control: public, max-age=3600
/og-image.jpg
  Cache-Control: public, max-age=3600
/favicon.ico
  Cache-Control: public, max-age=3600
/apple-touch-icon.png
  Cache-Control: public, max-age=3600
/site.webmanifest
  Cache-Control: public, max-age=3600
/data/*
  Cache-Control: public, max-age=300
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/shows
  Cache-Control: no-cache
/shows.html
  Cache-Control: no-cache
/404.html
  Cache-Control: no-cache
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# keep the pages.dev mirror out of search results (canonical is the apex domain)
https://:project.pages.dev/*
  X-Robots-Tag: noindex
