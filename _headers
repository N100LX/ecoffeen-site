# Every local asset is referenced with ?v=<content hash> (tools/build.py), so a changed file
# always has a new URL -> safe to cache for a year. HTML keeps Pages' default (max-age=0, must-revalidate).
/img/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/site.min.js
  Cache-Control: public, max-age=31536000, immutable
# fetched by crawlers / OS without a ?v
/img/og-share.jpg
  ! Cache-Control
  Cache-Control: public, max-age=3600
/favicon.ico
  Cache-Control: public, max-age=3600
/site.webmanifest
  Cache-Control: public, max-age=3600
/data/*
  Cache-Control: public, max-age=300
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
